{
  "name": "@depradar/api",
  "version": "0.0.1",
  "private": true,
  "description": "DepRadar FastAPI backend",
  "scripts": {
    "dev": "uv run uvicorn app.main:app --host 0.0.0.0 --port 5184 --reload",
    "start": "uv run uvicorn app.main:app --host 0.0.0.0 --port 5184",
    "lint": "uv run ruff check app/",
    "lint:fix": "uv run ruff check app/ --fix",
    "format": "uv run ruff format app/",
    "typecheck": "uv run pyright app/",
    "test": "uv run pytest",
    "migrate": "uv run alembic upgrade head",
    "migrate:new": "uv run alembic revision --autogenerate"
  }
}
