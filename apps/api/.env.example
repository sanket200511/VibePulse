# ─────────────────────────────────────────────────────────────────────────────
# VibePulse API – Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info
API_PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
# The URL must use the postgresql+asyncpg scheme for the async driver
# Assuming a local PostgreSQL installation with default port 5432
DATABASE_URL=postgresql+asyncpg://vibepulse:vibepulse_dev@localhost:5432/vibepulse

# ── Redis ─────────────────────────────────────────────────────────────────────
# Paste your Redis Cloud URL into REDIS_URL after the migration is complete.
# e.g., redis://default:yourpassword@redis-cloud-host:port
REDIS_URL=<PASTE_YOUR_REDIS_CLOUD_URL_HERE>

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# ── Session Engine ────────────────────────────────────────────────────────────
SESSION_IDLE_TIMEOUT_SECONDS=300
SESSION_COMPLETION_TIMEOUT_SECONDS=900
SESSION_SWEEP_INTERVAL_SECONDS=30
