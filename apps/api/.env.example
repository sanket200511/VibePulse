# ─────────────────────────────────────────────────────────────────────────────
# VibePulse API – Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info
API_PORT=5184

# ── Database ──────────────────────────────────────────────────────────────────
# The URL must use the postgresql+asyncpg scheme for the async driver
# Assuming a local PostgreSQL installation with default port 5432
DATABASE_URL=postgresql+asyncpg://vibepulse:vibepulse_dev@localhost:5432/vibepulse

# ── Redis / Upstash ───────────────────────────────────────────────────────────
# Option 1 (TCP): Standard or Upstash Redis TCP connection string with TLS
REDIS_URL=rediss://default:<UPSTASH_PASSWORD>@<UPSTASH_ENDPOINT>.upstash.io:6379

# Option 2 (REST): Serverless Upstash REST API (stateless over HTTPS port 443)
# UPSTASH_REDIS_REST_URL=https://<UPSTASH_ENDPOINT>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<UPSTASH_REST_TOKEN>

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5183","http://127.0.0.1:5183","http://localhost:3000","http://127.0.0.1:3000"]

# ── Session Engine ────────────────────────────────────────────────────────────
SESSION_IDLE_TIMEOUT_SECONDS=300
SESSION_COMPLETION_TIMEOUT_SECONDS=900
SESSION_SWEEP_INTERVAL_SECONDS=30

# ── Render Free-Tier Keep-Alive ─────────────────────────────────────────────
# Set to "true" to ping public /health every N minutes and keep instance awake.
# Set to "false" to allow Render instance to sleep after 15m and conserve monthly hours.
RENDER_KEEP_ALIVE=false
KEEP_ALIVE_INTERVAL_MINUTES=12
# Optional custom ping URL (defaults to RENDER_EXTERNAL_URL or https://vibepulse-api.onrender.com/health)
# RENDER_EXTERNAL_URL=https://vibepulse-api.onrender.com
