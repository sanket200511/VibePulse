# ─────────────────────────────────────────────────────────────────────────────
# VibePulse – Root Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=vibepulse
POSTGRES_PASSWORD=vibepulse_dev
POSTGRES_DB=vibepulse
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── pgAdmin ───────────────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@vibepulse.dev
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# ── Dedicated Service Ports (513x namespace) ──────────────────────────────────
# 5133 = API (VIBE)
# 5134 = Dashboard
# 5135 = Telemetry Daemon
VIBEPULSE_API_PORT=5133
VIBEPULSE_DASHBOARD_PORT=5134
VIBEPULSE_DAEMON_PORT=5135

API_PORT=5133
DASHBOARD_PORT=5134
DAEMON_PORT=5135
