{
  "name": "vibepulse",
  "version": "0.0.1",
  "private": true,
  "description": "VibePulse – Developer Observability Platform for the AI Coding Era",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "node scripts/dev-seminar.mjs",
    "dev:seminar": "node scripts/dev-seminar.mjs",
    "seminar:doctor": "node scripts/seminar-doctor.mjs",
    "dev:concurrent": "concurrently -p \"[{name}]\" -n \"api,dashboard,daemon\" -c \"blue,green,magenta\" \"pnpm run dev:api\" \"pnpm run dev:dashboard\" \"pnpm run dev:daemon\"",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "db:reset": "node scripts/reset-db.mjs",
    "verify": "turbo run typecheck lint test",
    "dev:api": "cd apps/api && uv run uvicorn app.main:app --port 8000",
    "dev:dashboard": "pnpm --filter @vibepulse/dashboard dev",
    "dev:daemon": "pnpm --filter @vibepulse/daemon dev",
    "dev:ui": "pnpm --filter @vibepulse/dashboard dev",
    "dev:frontend": "pnpm --filter @vibepulse/dashboard --filter @vibepulse/daemon --parallel dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,yaml,yml,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,yaml,yml,md,css}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "concurrently": "^10.0.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml,md,css,html}": [
      "prettier --write"
    ],
    "*.py": [
      "uv run --project apps/api ruff check --fix",
      "uv run --project apps/api ruff format"
    ]
  }
}
